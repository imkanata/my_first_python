import numpy as np
import matplotlib.pyplot as plt

# 全粉乳
icecream = np.genfromtxt("icecream.csv",
                         delimiter=",",
                         usecols=(0, 1)
                        )
m = icecream[:, 0]
ice = icecream[:, 1]

month = np.arange(1, 13, 1)
ice_clim = np.zeros(12)
for mm in range(1, 13):
    #print(ice)
    ice_clim[mm-1]=np.nanmean(ice[m==mm])

plt.bar(month, ice_clim)
plt.xticks(month)
plt.title("icecream")
plt.show()

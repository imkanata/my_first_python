import numpy as np
import matplotlib.pyplot as plb

tokyo_temp = np.genfromtxt("Tokyo_temp.csv",
                           delimiter=",",
                           useclos=(0, 1, 2)
                          )
y = tokyo_temp[:, 0]
m = tokyo_temp[:, 1]
temp = tokyo_temp[:, 2]
temp_old = temp[(1890 <= y)*(y <= 1919)]
temp_new = temp[(1990 <= y)*(y <= 2019)]
m_old = m[(1890 <= y)*(y <= 1919)]
m_new = m[(1990 <= y)*(y <= 2019)]







